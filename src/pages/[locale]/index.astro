---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { link, locales, type Locale } from '../../i18n/index';
import { getDict } from '../../i18n/dicts';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const dict = getDict(locale);
const builderUrl = link(locale, '/builder');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: dict.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<BaseLayout
  locale={locale}
  dict={dict}
  title={dict.meta.landingTitle}
  description={dict.meta.landingDescription}
  path="/"
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -top-32 start-1/4 h-96 w-96 rounded-full bg-brand-200/50 blur-3xl dark:bg-brand-600/10"></div>
      <div class="absolute top-40 end-1/5 h-72 w-72 rounded-full bg-brand-100/60 blur-3xl dark:bg-brand-600/5"></div>
    </div>

    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 pb-20 pt-16 sm:px-6 lg:grid-cols-2 lg:pt-24">
      <div>
        <p class="reveal inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-xs font-semibold text-brand-700 dark:border-brand-500/30 dark:bg-brand-500/10 dark:text-brand-300">
          <Icon name="ph:gift" class="h-3.5 w-3.5" />
          {dict.hero.badge}
        </p>
        <h1 class="reveal reveal-d1 mt-6 font-display text-5xl font-bold leading-[1.08] tracking-tight text-graphite-900 sm:text-6xl dark:text-white">
          {dict.hero.titleA}
          <span class="text-brand-600 dark:text-brand-400">{dict.hero.titleHighlight}</span>
          {dict.hero.titleB}
        </h1>
        <p class="reveal reveal-d2 mt-6 max-w-lg text-lg leading-relaxed text-graphite-500 dark:text-graphite-400">
          {dict.hero.subtitle}
        </p>
        <div class="reveal reveal-d3 mt-8 flex flex-wrap items-center gap-4">
          <a
            href={builderUrl}
            class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-7 py-3.5 font-semibold text-white transition hover:bg-brand-700"
          >
            <Icon name="ph:plus-circle" class="h-5 w-5" />
            {dict.hero.ctaPrimary}
          </a>
          <a
            href="#steps"
            class="inline-flex items-center gap-2 rounded-lg border border-graphite-300 px-7 py-3.5 font-semibold text-graphite-700 transition hover:border-brand-400 hover:text-brand-600 dark:border-graphite-700 dark:text-graphite-200 dark:hover:border-brand-400 dark:hover:text-brand-300"
          >
            {dict.hero.ctaSecondary}
            <Icon name="ph:arrow-down" class="h-5 w-5" />
          </a>
        </div>
      </div>

      <!-- CSS-only hero visual: stylized resume mock -->
      <div class="reveal reveal-d2 mx-auto w-full max-w-md" aria-hidden="true">
        <div class="rotate-2 rounded-2xl border border-graphite-200 bg-white p-6 shadow-xl dark:border-graphite-800 dark:bg-graphite-900">
          <div class="flex items-center gap-4">
            <div class="h-16 w-16 rounded-full bg-brand-100 dark:bg-brand-500/20"></div>
            <div class="flex-1">
              <div class="h-4 w-3/4 rounded bg-graphite-800 dark:bg-graphite-200"></div>
              <div class="mt-2 h-3 w-1/2 rounded bg-brand-500/70"></div>
            </div>
          </div>
          <div class="mt-6 space-y-3">
            <div class="h-3 w-1/3 rounded bg-graphite-300 dark:bg-graphite-700"></div>
            <div class="h-2.5 w-full rounded bg-graphite-200 dark:bg-graphite-800"></div>
            <div class="h-2.5 w-11/12 rounded bg-graphite-200 dark:bg-graphite-800"></div>
            <div class="h-2.5 w-full rounded bg-graphite-200 dark:bg-graphite-800"></div>
          </div>
          <div class="mt-5 space-y-3">
            <div class="h-3 w-1/4 rounded bg-graphite-300 dark:bg-graphite-700"></div>
            <div class="flex gap-2">
              <div class="h-7 w-20 rounded-full bg-brand-50 border border-brand-200 dark:border-brand-500/30 dark:bg-brand-500/10"></div>
              <div class="h-7 w-24 rounded-full bg-brand-50 border border-brand-200 dark:border-brand-500/30 dark:bg-brand-500/10"></div>
              <div class="h-7 w-16 rounded-full bg-brand-50 border border-brand-200 dark:border-brand-500/30 dark:bg-brand-500/10"></div>
            </div>
          </div>
          <div class="mt-5 flex justify-end">
            <div class="inline-flex items-center gap-1.5 rounded-lg bg-brand-600 px-4 py-2">
              <div class="h-3 w-3 rounded-full bg-white/80"></div>
              <div class="h-2.5 w-16 rounded bg-white/80"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STEPS ============ -->
  <section id="steps" class="bg-[#F8F9FA] dark:bg-graphite-900/50">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="reveal font-display text-3xl font-bold tracking-tight text-graphite-900 sm:text-4xl dark:text-white">
          {dict.steps.title}
        </h2>
        <p class="reveal reveal-d1 mt-4 text-graphite-500 dark:text-graphite-400">{dict.steps.subtitle}</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {dict.steps.items.map((s, i) => (
          <article class={`reveal rounded-2xl border border-graphite-200 bg-white p-8 dark:border-graphite-800 dark:bg-graphite-900 ${i === 1 ? 'reveal-d1' : i === 2 ? 'reveal-d2' : ''}`}>
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-600 font-display text-lg font-bold text-white">
              {i + 1}
            </div>
            <h3 class="mt-5 font-display text-lg font-semibold text-graphite-900 dark:text-white">{s.title}</h3>
            <p class="mt-2.5 leading-relaxed text-graphite-500 dark:text-graphite-400">{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WHY ============ -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="reveal font-display text-3xl font-bold tracking-tight text-graphite-900 sm:text-4xl dark:text-white">
        {dict.why.title}
      </h2>
      <p class="reveal reveal-d1 mt-4 text-graphite-500 dark:text-graphite-400">{dict.why.subtitle}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {dict.why.items.map((f, i) => (
        <article class={`reveal rounded-2xl border border-graphite-200 bg-white p-8 dark:border-graphite-800 dark:bg-graphite-900 ${i % 3 === 1 ? 'reveal-d1' : i % 3 === 2 ? 'reveal-d2' : ''}`}>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-300">
            <Icon name={f.icon} class="h-6 w-6" />
          </div>
          <h3 class="mt-5 font-display text-lg font-semibold text-graphite-900 dark:text-white">{f.title}</h3>
          <p class="mt-2.5 leading-relaxed text-graphite-500 dark:text-graphite-400">{f.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section id="faq" class="bg-[#F8F9FA] dark:bg-graphite-900/50">
    <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
      <div class="text-center">
        <h2 class="reveal font-display text-3xl font-bold tracking-tight text-graphite-900 sm:text-4xl dark:text-white">
          {dict.faq.title}
        </h2>
        <p class="reveal reveal-d1 mt-4 text-graphite-500 dark:text-graphite-400">{dict.faq.subtitle}</p>
      </div>
      <div class="mt-10 space-y-4">
        {dict.faq.items.map((item) => (
          <details class="faq-item reveal rounded-2xl border border-graphite-200 bg-white px-6 py-4 dark:border-graphite-800 dark:bg-graphite-900">
            <summary class="flex items-center justify-between gap-4 font-medium text-graphite-900 dark:text-white">
              {item.q}
              <Icon name="ph:caret-down" class="faq-chevron h-5 w-5 shrink-0 text-brand-600 dark:text-brand-400" />
            </summary>
            <p class="mt-3 leading-relaxed text-graphite-500 dark:text-graphite-400">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ============ CTA BAND ============ -->
  <section class="bg-brand-600 dark:bg-brand-700">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
      <h2 class="reveal font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {dict.ctaBand.title}
      </h2>
      <p class="reveal reveal-d1 mx-auto mt-4 max-w-2xl text-brand-100">{dict.ctaBand.text}</p>
      <a
        href={builderUrl}
        class="reveal reveal-d2 mt-8 inline-flex items-center gap-2 rounded-lg bg-white px-8 py-3.5 font-semibold text-brand-700 transition hover:bg-brand-50"
      >
        <Icon name="ph:plus-circle" class="h-5 w-5" />
        {dict.ctaBand.button}
      </a>
    </div>
  </section>
</BaseLayout>
