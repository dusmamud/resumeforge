---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BRAND } from '../../brand';
import { locales, type Locale } from '../../i18n/index';
import { getDict } from '../../i18n/dicts';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const dict = getDict(locale);
---
<BaseLayout locale={locale} dict={dict} title={dict.meta.aboutTitle} description={dict.meta.aboutDescription} path="/about">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-24">
    <p class="reveal inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-xs font-semibold text-brand-700 dark:border-brand-500/30 dark:bg-brand-500/10 dark:text-brand-300">
      <Icon name="ph:info" class="h-3.5 w-3.5" />
      {BRAND.name}
    </p>
    <h1 class="reveal reveal-d1 mt-6 font-display text-4xl font-bold tracking-tight text-graphite-900 sm:text-5xl dark:text-white">
      {dict.about.title}
    </h1>
    <div class="reveal reveal-d2 mt-8 space-y-6 text-lg leading-relaxed text-graphite-500 dark:text-graphite-400">
      <p>{dict.about.p1}</p>
      <p>{dict.about.p2}</p>
      <p>{dict.about.p3}</p>
    </div>
  </section>
</BaseLayout>
