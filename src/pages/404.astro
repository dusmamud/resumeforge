---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDict } from '../i18n/dicts';
import { BRAND } from '../brand';
import { link } from '../i18n/index';

const locale = 'en';
const dict = getDict(locale);
---
<BaseLayout locale={locale} dict={dict} title={`404 — ${BRAND.name}`} description={dict.meta.landingDescription} path="/">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-brand-50 text-brand-600 dark:bg-brand-500/10 dark:text-brand-300">
      <Icon name="ph:file-x" class="h-10 w-10" />
    </div>
    <h1 class="mt-8 font-display text-4xl font-bold tracking-tight text-graphite-900 sm:text-5xl dark:text-white">
      {dict.notFound.title}
    </h1>
    <p class="mx-auto mt-4 max-w-md text-graphite-500 dark:text-graphite-400">{dict.notFound.text}</p>
    <a
      href={link('en', '/')}
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-brand-600 px-7 py-3.5 font-semibold text-white transition hover:bg-brand-700"
    >
      <Icon name="ph:house" class="h-5 w-5" />
      {dict.notFound.button}
    </a>
  </section>
</BaseLayout>
